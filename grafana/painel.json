{
  "title": "Meu Político de Estimação — saúde das rotinas",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Última execução (1 = sucesso)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "last_over_time(rotina_execucao_sucesso[2d])",
          "legendFormat": "{{workflow}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "stat",
      "title": "Trava disparada (30 dias)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(rotina_execucao_trava_disparou[30d]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Duração total (s)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "rotina_execucao_duracao_total_s",
          "legendFormat": "{{workflow}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Duração por etapa (s)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rotina_etapa_duracao_s",
          "legendFormat": "{{etapa}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Volume coletado",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rotina_contagem_valor",
          "legendFormat": "{{tipo}} {{casa}} {{ano}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  }
}
