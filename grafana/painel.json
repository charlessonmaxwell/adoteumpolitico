{
  "title": "Adote um Político — saúde das rotinas",
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Última execução (1 = sucesso)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "last_over_time(rotina_execucao_sucesso[2d])",
          "legendFormat": "{{workflow}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "stat",
      "title": "Trava disparada (30 dias)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(sum_over_time(rotina_execucao_trava_disparou[30d]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Duração total (s)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "rotina_execucao_duracao_total_s",
          "legendFormat": "{{workflow}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Duração por etapa (s)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rotina_etapa_duracao_s",
          "legendFormat": "{{etapa}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Volume coletado",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rotina_contagem_valor",
          "legendFormat": "{{tipo}} {{casa}} {{ano}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "row",
      "title": "Visitas do site (dia anterior, Cloudflare Web Analytics)",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Visitas por dia",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "expr": "max_over_time(site_visitas_visitas[1d])",
          "legendFormat": "Visitas",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Páginas vistas por dia",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "expr": "max_over_time(site_visitas_paginas[1d])",
          "legendFormat": "Páginas vistas",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Páginas mais vistas (ontem)",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "expr": "sort_desc(last_over_time(site_pagina_paginas[2d]))",
          "legendFormat": "{{caminho}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "De onde vêm as visitas (ontem)",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "expr": "last_over_time(site_origem_visitas[2d])",
          "legendFormat": "{{origem}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Celular x computador (ontem)",
      "gridPos": {
        "x": 18,
        "y": 22,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "targets": [
        {
          "expr": "last_over_time(site_dispositivo_visitas[2d])",
          "legendFormat": "{{tipo}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  }
}
