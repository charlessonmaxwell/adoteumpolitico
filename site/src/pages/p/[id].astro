---
import Perfil from "../../components/Perfil.astro";
import { arquivo, dados } from "../../lib/dados";
import type { ResumoParlamentar } from "../../../../pipeline/src/rotina/agregacao";

/** Quem está no cargo + quem saiu (perfil guardado da última legislatura em que aparece — story 9.2). */
export function getStaticPaths() {
  const vistos = new Set(dados().resumos.map((r) => r.parlamentar.id));
  const paginas: { params: { id: string }; props: { r: ResumoParlamentar; leg: number | null } }[] =
    dados().resumos.map((r) => ({ params: { id: r.parlamentar.id }, props: { r, leg: null } }));
  for (const a of arquivo())
    for (const r of a.resumos)
      if (!vistos.has(r.parlamentar.id)) {
        vistos.add(r.parlamentar.id);
        paginas.push({ params: { id: r.parlamentar.id }, props: { r, leg: a.leg } });
      }
  return paginas;
}

const { r, leg } = Astro.props;
---
<Perfil r={r} leg={leg} />
