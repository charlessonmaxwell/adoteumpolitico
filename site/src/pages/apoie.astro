---
import QRCode from "qrcode";
import Base from "../layouts/Base.astro";
import Icone from "../components/Icone.astro";
import { codigoPix } from "../lib/pix";

// Chave aleatória do Pix (não expõe CPF nem telefone). Configurada no GitHub (variáveis PIX_*).
const chave = import.meta.env.PUBLIC_PIX_CHAVE ?? "";
const nome = import.meta.env.PUBLIC_PIX_NOME ?? "Adote um Politico";
const cidade = import.meta.env.PUBLIC_PIX_CIDADE ?? "Aracaju";
const pix = chave ? codigoPix({ chave, nome, cidade, mensagem: "Apoio Adote um Politico" }) : "";
const qr = pix ? await QRCode.toString(pix, { type: "svg", margin: 1, errorCorrectionLevel: "M" }) : "";
---
<Base titulo="Apoie o Adote um Político" descricao="O Adote um Político é independente e não tem lado. Se ele te ajuda a fiscalizar, apoie com um Pix de qualquer valor.">
  <div class="conteiner pagina-apoie">
    <p class="volta"><a href="/">Início</a></p>
    <h1>Fiscalizar é de graça.<br />Manter no ar, não.</h1>
    <p class="intro">O Adote um Político é <strong>independente e não tem lado</strong>. Não vende anúncio, não recebe dinheiro de governo e não aceita dinheiro de político. Se ele te ajuda a acompanhar quem você elegeu, ajude a manter ele no ar.</p>

    <div class="grade">
      <section class="cartao pix">
        <h2><span class="selo"><Icone nome="dinheiro" /></span>Doe com Pix, qualquer valor</h2>
        {pix ? (
          <>
            <div class="qr" set:html={qr} role="img" aria-label="QR code do Pix para doação" />
            <p class="dica">Abra o app do banco, escolha <strong>Pix → Ler QR code</strong> ou use o <strong>copia e cola</strong>:</p>
            <div class="copia">
              <code data-pix>{pix}</code>
              <button type="button" class="botao" data-copiar-pix>Copiar código Pix</button>
            </div>
            <p class="nota">Você escolhe o valor no app. R$ 5 já ajuda.</p>
          </>
        ) : (
          <p class="em-breve">O Pix para doações entra no ar em breve.</p>
        )}
      </section>

      <section class="cartao">
        <h2><span class="selo"><Icone nome="documento" /></span>Para que serve o seu apoio</h2>
        <ul class="lista">
          <li>Manter o site no ar e atualizado todo dia, com dado oficial.</li>
          <li>Trazer mais informação: prestação de contas das emendas, gastos mês a mês, mais explicações simples.</li>
          <li>Continuar <strong>sem anúncio</strong> e <strong>sem dono político</strong>.</li>
        </ul>
      </section>

      <section class="cartao regras">
        <h2><span class="selo"><Icone nome="urna" /></span>Quem não pode doar</h2>
        <p>Para o site continuar sem lado, <strong>não aceitamos e devolvemos</strong> doações de:</p>
        <ul class="lista">
          <li>partidos políticos;</li>
          <li>políticos, candidatos e gabinetes;</li>
          <li>empresas que tenham contrato com o governo.</li>
        </ul>
        <p class="nota">Apoiar não dá direito a nada no conteúdo: os números são os mesmos para todo mundo, com a fonte oficial de cada um.</p>
      </section>
    </div>

    <p class="sem-dinheiro">Não pode doar agora? <strong>Compartilhar também ajuda.</strong> Mande o perfil do seu deputado ou a página da sua cidade no grupo da família.</p>
  </div>
</Base>
<script>
  const b = document.querySelector<HTMLButtonElement>("[data-copiar-pix]");
  b?.addEventListener("click", async () => {
    const texto = document.querySelector("[data-pix]")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(texto);
      b.textContent = "Código copiado! Cole no app do banco";
    } catch {
      b.textContent = "Não deu para copiar: segure o código e copie";
    }
    setTimeout(() => (b.textContent = "Copiar código Pix"), 3500);
  });
</script>
<style is:global>
  .pagina-apoie .volta { margin: 2rem 0 1rem; font-size: 0.95rem; }
  .pagina-apoie h1 { font-family: var(--numeros); font-stretch: 80%; font-weight: 800; font-size: clamp(2.3rem, 6vw, 3.6rem); line-height: 1; margin: 0 0 0.8rem; color: var(--dado); }
  .pagina-apoie .intro { max-width: 62ch; font-size: 1.12rem; color: var(--tinta-suave); }
  .pagina-apoie .grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .pagina-apoie .cartao { background: var(--folha); border: 1px solid var(--linha); border-radius: 10px; padding: 1.3rem 1.4rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .pagina-apoie .cartao p { margin: 0; }
  .pagina-apoie .pix { grid-row: span 2; }
  .pagina-apoie h2 { display: flex; align-items: center; gap: 0.6rem; font-family: var(--numeros); font-stretch: 90%; font-weight: 750; font-size: 1.25rem; margin: 0; }
  .pagina-apoie .selo { display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--dado); color: var(--folha); flex: none; }
  .pagina-apoie .qr { width: min(15rem, 100%); align-self: center; background: #fff; padding: 0.5rem; border-radius: 10px; }
  .pagina-apoie .qr svg { display: block; width: 100%; height: auto; }
  .pagina-apoie .copia { display: grid; gap: 0.5rem; }
  .pagina-apoie .copia code { display: block; font-size: 0.75rem; word-break: break-all; background: var(--fundo); border: 1px dashed var(--linha); border-radius: 8px; padding: 0.6rem; max-height: 6rem; overflow: auto; }
  .pagina-apoie .botao { font: inherit; font-weight: 700; padding: 0.8rem 1rem; border-radius: 999px; border: 0; background: var(--dado); color: var(--folha); cursor: pointer; }
  .pagina-apoie .botao:focus-visible { outline: 3px solid var(--foco); outline-offset: 2px; }
  .pagina-apoie .lista { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .pagina-apoie .nota, .pagina-apoie .dica { font-size: 0.9rem; color: var(--grafite); }
  .pagina-apoie .em-breve { color: var(--tinta-suave); }
  .pagina-apoie .sem-dinheiro { font-size: 1.05rem; margin: 0.5rem 0 3rem; }
</style>
