---
import "../styles/global.css";
interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
}
const { titulo, descricao, imagem = "/og/inicio.png" } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(imagem, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content="Adote um Político" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#eef2f1" />
    <script is:inline>
      // Aplica o modo salvo antes de desenhar a página (evita piscar). Sem escolha salva = claro.
      try {
        if (localStorage.getItem("tema") === "noturno") document.documentElement.dataset.tema = "noturno";
      } catch {}
    </script>
  </head>
  <body>
    <header class="topo">
      <div class="conteiner topo-in">
        <a href="/" class="marca">Adote um Político</a>
        <div class="acoes">
          <a href="/panorama/" class="buscar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
            <span>Panorama</span>
          </a>
          <a href="/#busca" class="buscar" aria-label="Buscar parlamentar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" /></svg>
            <span>Buscar</span>
          </a>
          <button type="button" class="modo" id="alternar-tema" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
            <span>Modo noturno</span>
          </button>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="rodape">
      <div class="conteiner">
        <p>Aqui não tem nota nem ranking: só os fatos, com a fonte oficial de cada um. Os dados vêm da Câmara dos Deputados e do Senado Federal e são atualizados todo dia.</p>
        <p class="links"><a href="/panorama/">Panorama do Congresso</a> <a href="/como-funciona/">Como funciona</a> <a href="https://github.com/charlessonmaxwell/adoteumpolitico">Código aberto</a> <a href="https://github.com/charlessonmaxwell/adoteumpolitico/issues/new">Achou um erro?</a></p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var b = document.getElementById("alternar-tema");
        var raiz = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        function aplicar(noturno) {
          if (noturno) raiz.dataset.tema = "noturno";
          else delete raiz.dataset.tema;
          b.setAttribute("aria-pressed", String(noturno));
          b.querySelector("span").textContent = noturno ? "Modo claro" : "Modo noturno";
          if (meta) meta.setAttribute("content", noturno ? "#14161b" : "#eef2f1");
        }
        aplicar(raiz.dataset.tema === "noturno");
        b.addEventListener("click", function () {
          var noturno = raiz.dataset.tema !== "noturno";
          aplicar(noturno);
          try { localStorage.setItem("tema", noturno ? "noturno" : "claro"); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
<style>
  .topo { border-bottom: 1px solid var(--linha); background: var(--papel); }
  .topo-in { display: flex; justify-content: space-between; align-items: center; min-height: 3.5rem; gap: 1rem; }
  .marca { font-family: var(--numeros); font-stretch: 87%; font-weight: 800; color: var(--tinta); text-decoration: none; font-size: 1.1rem; }
  .acoes { display: flex; align-items: center; gap: 1rem; }
  .buscar { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.95rem; color: var(--tinta); text-decoration: none; font-weight: 600; }
  .buscar svg { width: 1.2rem; height: 1.2rem; }
  .modo { display: inline-flex; align-items: center; gap: 0.4rem; font: inherit; font-size: 0.9rem; color: var(--tinta); background: var(--folha); border: 1px solid var(--linha); border-radius: 999px; padding: 0.35rem 0.8rem; cursor: pointer; }
  .modo svg { width: 1.1rem; height: 1.1rem; }
  .modo:hover { border-color: var(--dado); }
  .modo:focus-visible { outline: 3px solid var(--foco); outline-offset: 2px; }
  @media (max-width: 34rem) { .buscar span, .modo span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } }
  .rodape { margin-top: 4rem; border-top: 1px solid var(--linha); color: var(--grafite); font-size: 0.92rem; padding: 1.5rem 0 3rem; }
  .rodape p { max-width: 65ch; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
</style>
