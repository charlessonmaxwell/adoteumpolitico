---
/** Ícones de traço próprios (sem biblioteca), herdam a cor do texto. */
interface Props {
  nome: "calendario" | "dinheiro" | "documento" | "urna" | "lupa" | "mapa";
}
const { nome } = Astro.props;
---
<svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nome === "calendario" && (<><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /><path d="m9 15 2 2 4-4" /></>)}
  {nome === "dinheiro" && (<><rect x="2.5" y="6" width="19" height="12" rx="2.5" /><circle cx="12" cy="12" r="2.8" /><path d="M6 9.5v5M18 9.5v5" /></>)}
  {nome === "documento" && (<><path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4M9 12h6M9 16h4" /></>)}
  {nome === "urna" && (<><path d="M4 11h16v9H4z" /><path d="M9 11V5.5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1V11M8 15h8" /><path d="m10.5 8 1.2 1.2L14 7" /></>)}
  {nome === "lupa" && (<><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" /></>)}
  {nome === "mapa" && (<><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21z" /><circle cx="12" cy="10" r="2.3" /></>)}
</svg>
<style>
  .icone { width: 1.5em; height: 1.5em; flex: none; }
</style>
