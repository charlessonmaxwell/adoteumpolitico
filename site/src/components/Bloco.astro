---
/** Bloco do perfil: ícone + pergunta → destaque → frase → gráfico → "ver os números" → fonte. */
import Icone from "./Icone.astro";
import Texto from "./Texto.astro";
interface Props {
  titulo: string;
  icone: "calendario" | "dinheiro" | "documento" | "urna";
  destaque?: { valor: string; rotulo: string } | null;
  principal: string | null;
  detalhes?: string[];
  vazio?: string;
  fonte: { nome: string; url: string };
  atualizadoEm: string;
}
const { titulo, icone, destaque, principal, detalhes = [], vazio, fonte, atualizadoEm } = Astro.props;
const usados = new Set<string>();
const id = titulo.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/\W+/g, "-");
---
<section class="bloco" aria-labelledby={id}>
  <h2 id={id}><span class="selo"><Icone nome={icone} /></span>{titulo}</h2>
  {principal ? (
    <>
      {destaque && (
        <p class="destaque"><strong>{destaque.valor}</strong> <span>{destaque.rotulo}</span></p>
      )}
      <p class="principal"><Texto texto={principal} usados={usados} /></p>
      {detalhes.length > 0 && <ul class="detalhes">{detalhes.map((d) => <li><Texto texto={d} usados={usados} /></li>)}</ul>}
      <div class="grafico"><slot name="grafico" /></div>
      {Astro.slots.has("numeros") && (
        <details>
          <summary>Ver os números</summary>
          <slot name="numeros" />
        </details>
      )}
    </>
  ) : (
    <p class="vazio">{vazio}</p>
  )}
  <p class="fonte">Fonte: <a href={fonte.url} rel="external noopener" target="_blank">{fonte.nome}</a>. Dados de {atualizadoEm}.</p>
</section>
<style>
  .bloco { background: var(--folha); border: 1px solid var(--linha); border-radius: 10px; padding: 1.5rem 1.5rem 1.1rem; display: flex; flex-direction: column; gap: 0.9rem; }
  h2 { display: flex; align-items: center; gap: 0.7rem; font-family: var(--numeros); font-stretch: 90%; font-weight: 750; font-size: 1.3rem; color: var(--tinta); margin: 0; }
  .selo { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: var(--dado-fundo); color: var(--dado); font-size: 0.95rem; }
  .destaque { margin: 0.2rem 0 0; display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .destaque strong { font-family: var(--numeros); font-stretch: 78%; font-weight: 800; font-size: clamp(3rem, 7vw, 4.2rem); line-height: 0.9; color: var(--dado); font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .destaque span { color: var(--grafite); font-size: 1rem; max-width: 18ch; line-height: 1.25; }
  .principal { font-size: 1.3rem; line-height: 1.35; margin: 0; max-width: 36ch; text-wrap: balance; }
  .detalhes { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.3rem; color: var(--tinta-suave); }
  .grafico { margin-top: 0.3rem; }
  .vazio { color: var(--grafite); margin: 0; }
  details { border-top: 1px dashed var(--linha); padding-top: 0.7rem; }
  summary { cursor: pointer; color: var(--acento-texto); font-weight: 700; }
  summary:focus-visible { outline: 3px solid var(--foco); outline-offset: 2px; border-radius: 4px; }
  .fonte { margin: auto 0 0; padding-top: 0.6rem; font-size: 0.85rem; color: var(--grafite); }
  .fonte a { color: inherit; }
</style>
