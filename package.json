{
  "name": "meu-politico-de-estimacao",
  "version": "0.1.0",
  "private": true,
  "description": "Portal público que mostra, em linguagem simples, o desempenho de deputados federais e senadores a partir de dados oficiais.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "coleta:parlamentares": "tsx pipeline/src/coleta/parlamentares.ts",
    "coleta:gastos": "tsx pipeline/src/coleta/gastos.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
