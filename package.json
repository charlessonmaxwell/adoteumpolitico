{
  "name": "adote-um-politico",
  "version": "0.1.0",
  "private": true,
  "description": "Portal público que mostra, em linguagem simples, o desempenho de deputados federais e senadores a partir de dados oficiais.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "coleta:parlamentares": "tsx pipeline/src/coleta/parlamentares.ts",
    "coleta:gastos": "tsx pipeline/src/coleta/gastos.ts",
    "coleta:proposicoes": "tsx pipeline/src/coleta/proposicoes.ts",
    "coleta:votacoes": "tsx pipeline/src/coleta/votacoes.ts",
    "coleta:presenca-camara": "tsx pipeline/src/coleta/presenca-camara.ts",
    "rotina": "tsx pipeline/src/rotina/index.ts",
    "explicacoes": "tsx pipeline/src/explicacao/manual.ts",
    "rotina:emendas": "tsx pipeline/src/emendas/rotina.ts",
    "rotina:palacio": "tsx pipeline/src/palacio/rotina.ts",
    "site:dev": "astro dev",
    "site:build": "astro build",
    "site:check": "astro check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.7",
    "fflate": "^0.8.3",
    "qrcode": "1.5.4",
    "satori": "^0.63.2",
    "unpdf": "2.1.0"
  }
}
